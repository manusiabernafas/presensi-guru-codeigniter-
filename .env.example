#--------------------------------------------------------------------
# Salin file ini menjadi .env (setup.bat / setup.sh melakukannya otomatis)
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# Kosongkan agar alamat terdeteksi otomatis (http://localhost/presensi-guru-ekskul/).
# Isi bila memakai domain, contoh: app.baseURL = 'https://presensi.sekolahku.sch.id/'
# app.baseURL = ''

database.default.hostname = localhost
database.default.database = presensi_guru
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
